# Production domain for canonicals, sitemap and structured data (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.r-und-r-dach.at
# Set to false only to force noindex. Production defaults to indexing when unset.
NEXT_PUBLIC_INDEXING_ENABLED=true
# Optional: GTM container. GA4 event mapping can still live in GTM when set.
NEXT_PUBLIC_GTM_ID=
# Google Ads conversion ID (defaults to AW-18521702973 in code when unset).
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18521702973
# Search Console HTML verification (defaults to the production token in code when unset).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=YdFJNuk6dv7W_EJRskOmtMxzbdkI0N1M7doDMV6OBw4
# Contact form: server-only Resend settings. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional: shared Redis-compatible REST store for production rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
