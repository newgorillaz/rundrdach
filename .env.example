# Set the real HTTPS domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=
# Keep false until business details, legal pages and domain are complete.
NEXT_PUBLIC_INDEXING_ENABLED=false
# Optional: GTM container only. GA4 and Ads are configured inside GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Contact form: server-only Resend settings. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional: shared Redis-compatible REST store for production rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
